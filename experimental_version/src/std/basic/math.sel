// --- namespace shortcuts ---
#define basic'* = std'basic'*.

// --- Abs ---

#symbol Abs : aNumber
    = #inline standard'r64abs(basic'RealNumber, aNumber $getReal).

// --- Rounded ---

#symbol Rounded : aNumber
    = #inline standard'r64conv66(basic'IntNumber, aNumber $getReal).

// --- Int ---

#symbol Int : aNumber
    = #inline standard'r64conv67(basic'RealNumber, aNumber $getReal).

// --- ArcTan ---

#symbol ArcTan : aNumber
    = #inline standard'r64conv68(basic'RealNumber, aNumber $getReal).

// --- Cos ---

#symbol Cos : aNumber
    = #inline standard'r64conv69(basic'RealNumber, aNumber $getReal).

// --- Exp ---

#symbol Exp : aNumber
    = #inline standard'r64conv70(basic'RealNumber, aNumber $getReal).

// --- Frac ---

#symbol Frac : aNumber
    = (aNumber - Int::aNumber).

// --- Ln ---

#symbol Ln : aNumber
    = #inline standard'r64conv71(basic'RealNumber, aNumber $getReal).

// --- Sin ---

#symbol Sin : aNumber
    = #inline standard'r64conv72(basic'RealNumber, aNumber $getReal).

// --- Sqrt ---

#symbol Sqrt : aNumber
    = #inline standard'r64conv73(basic'RealNumber, aNumber $getReal).

// --- Pi ---

#symbol Pi
    = #inline standard'r64conv74(basic'RealNumber).
