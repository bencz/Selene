[project]
executable=bin\upndown.exe
output=tmp
entry='entry
package=cardgame
template=gui
projecttype=2
debuginfo=-1
warn:unresolved=0

[files]
configs.l
game.l
game\upndown.l
engine.l
engine\cards.l
engine\net.l
players.l
players\net.l
gui\forms.l
net.l
players\forms.l

[forwards]
'mainwindow=cardgame'gui'forms'playground
'players'hostextensionfactories=cardgame'configs'hostplayerextensionfactories
'program'modules=cardgame'configs'modules
'players'clientextensionfactories=cardgame'configs'clientplayerextensionfactories
'players'remoteextensionfactories=cardgame'configs'remoteplayerextensionfactories
'master'factories=cardgame'configs'masterextensionfactories
'rulebook=cardgame'game'upndown'rulebook

