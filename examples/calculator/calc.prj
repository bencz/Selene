[project]
executable=calc.exe
entry=sys'templates'commandcycle
package=calc
template=console
projecttype=1
debuginfo=-1
warn:unresolved=0

[files]
parser.l
math.l
control.l

[forwards]
'program=calc'control'program
'program'output=calc'control'output
'program'input=calc'control'input
'calc'operations=calc'control'operations

